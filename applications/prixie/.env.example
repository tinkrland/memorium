# recall.ai (zoom, google meet, teams, slack, webex)
RECALL_API_KEY=your_recall_api_key

# browserbase (discord, bluejeans, ringcentral, custom)
BROWSERBASE_API_KEY=your_browserbase_api_key
BROWSERBASE_PROJECT_ID=your_project_id

# assembly.ai (transcription for browserbase sessions)
ASSEMBLYAI_API_KEY=your_assemblyai_key

# supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# google calendar (optional, for calendar sync)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# public url of your backend (for recall.ai webhooks)
WEBHOOK_URL=https://your-backend-url.com

# port
PORT=3000

# scheduler
ENABLE_SCHEDULER=true

# speechmatics (optional, for hinglish / non-english STT)
SPEECHMATICS_API_KEY=your_speechmatics_key

# speechify (optional, for future voice feature / TTS)
SPEECHIFY_API_KEY=your_speechify_key

# vapi (optional, for future voice interaction)
VAPI_API_KEY=your_vapi_key
